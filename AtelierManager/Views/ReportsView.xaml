<UserControl x:Class="AtelierManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1000"
             Loaded="ReportsView_Loaded"
             SizeChanged="ReportsView_SizeChanged">

    <UserControl.Resources>
        <!--
            Безопасная область для LiveCharts при демонстрации через проектор.
            Диаграмма получает фиксированную логическую область, а Viewbox только уменьшает её,
            если окно/экран становятся меньше. Типы диаграмм LiveCharts не меняются.
        -->
        <Style x:Key="ChartGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="ChartViewport" TargetType="Border">
            <Setter Property="Height" Value="260"/>
            <Setter Property="MinHeight" Value="210"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="SafePieChart" TargetType="{x:Type lvc:PieChart}">
            <Setter Property="Width" Value="860"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="MinWidth" Value="360"/>
            <Setter Property="MinHeight" Value="180"/>
            <Setter Property="LegendPosition" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SafeCartesianChart" TargetType="{x:Type lvc:CartesianChart}">
            <Setter Property="Width" Value="860"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="MinWidth" Value="360"/>
            <Setter Property="MinHeight" Value="180"/>
            <Setter Property="LegendPosition" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ReportsRoot" Margin="12" MinWidth="0" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <WrapPanel Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="С" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding DateFrom}"/>
            </StackPanel>

            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="По" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding DateTo}"/>
            </StackPanel>

            <StackPanel Margin="0,0,12,0" Width="180">
                <TextBlock Text="Статус" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel Margin="0,0,12,0" Width="220">
                <TextBlock Text="Клиент" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ClientFilters}"
                          SelectedItem="{Binding SelectedClientFilter}"
                          DisplayMemberPath="FullName"/>
            </StackPanel>

            <StackPanel Margin="0,0,12,0" Width="220">
                <TextBlock Text="Работник" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding EmployeeFilters}"
                          SelectedItem="{Binding SelectedEmployeeFilter}"
                          DisplayMemberPath="FullName"/>
            </StackPanel>

            <Button Style="{StaticResource ActionButton}" Click="BuildReport_Click">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Creation" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Сформировать"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource ActionButton}" Click="ExportReport_Click">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="FileExcel" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Экспорт в Excel"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Карточки -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Заказов" Opacity="0.7"/>
                    <TextBlock Text="{Binding OrdersCount}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Выручка без отменённых" Opacity="0.7"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:0.##}}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Готово / Выдано" Opacity="0.7"/>
                    <TextBlock Text="{Binding CompletedCount}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2" SelectedIndex="0" MinHeight="0">

            <!-- ================= ТАБЛИЦЫ ================= -->
            <TabItem Header="Таблицы">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,0">

                        <!-- Заказы -->
                        <GroupBox Header="Заказы за период" Margin="0,0,0,12">
                            <DataGrid ItemsSource="{Binding ReportOrders}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Клиент" Binding="{Binding Client.FullName}" Width="220"/>
                                    <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="*"/>
                                    <DataGridTextColumn Header="Принят" Binding="{Binding IntakeDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status.Name}" Width="100"/>
                                    <DataGridTextColumn Header="Работник" Binding="{Binding Employee.FullName}" Width="160"/>
                                    <DataGridTextColumn Header="Выручка" Binding="{Binding TotalCost, StringFormat={}{0:0.##}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Популярные услуги -->
                        <GroupBox Header="Популярные услуги" Margin="0,0,0,12">
                            <DataGrid ItemsSource="{Binding TopServices}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="*"/>
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="100"/>
                                    <DataGridTextColumn Header="Выручка" Binding="{Binding TotalAmount, StringFormat={}{0:0.##}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Работники -->
                        <GroupBox Header="Заказы по работникам" Margin="0,0,0,12">
                            <DataGrid ItemsSource="{Binding EmployeeStats}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Работник" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="100"/>
                                    <DataGridTextColumn Header="Выручка" Binding="{Binding TotalAmount, StringFormat={}{0:0.##}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Материалы -->
                        <GroupBox Header="Расход материалов">
                            <DataGrid ItemsSource="{Binding MaterialUsage}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding QuantityUsed, StringFormat={}{0:0.##}}" Width="120"/>
                                    <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="80"/>
                                    <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalAmount, StringFormat={}{0:0.##}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= ДИАГРАММЫ ================= -->
            <TabItem Header="Диаграммы">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel x:Name="ChartsHost" Margin="0,8,0,0" MinWidth="0">

                        <GroupBox Header="По статусам" Style="{StaticResource ChartGroupBox}">
                            <Border Style="{StaticResource ChartViewport}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <lvc:PieChart x:Name="StatusChart"
                                                  Style="{StaticResource SafePieChart}"
                                                  Series="{Binding StatusSeries}"/>
                                </Viewbox>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="По типу заказа" Style="{StaticResource ChartGroupBox}">
                            <Border Style="{StaticResource ChartViewport}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <lvc:PieChart x:Name="OrderTypeChart"
                                                  Style="{StaticResource SafePieChart}"
                                                  Series="{Binding OrderTypeSeries}"/>
                                </Viewbox>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="По работникам" Style="{StaticResource ChartGroupBox}">
                            <Border Style="{StaticResource ChartViewport}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <lvc:PieChart x:Name="EmployeeChart"
                                                  Style="{StaticResource SafePieChart}"
                                                  Series="{Binding EmployeeSeries}"/>
                                </Viewbox>
                            </Border>
                        </GroupBox>

                        <GroupBox Header="По месяцам" Style="{StaticResource ChartGroupBox}">
                            <Border Style="{StaticResource ChartViewport}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <lvc:CartesianChart x:Name="MonthChart"
                                                        Style="{StaticResource SafeCartesianChart}"
                                                        Series="{Binding MonthSeries}"
                                                        XAxes="{Binding MonthXAxes}"
                                                        YAxes="{Binding MonthYAxes}"/>
                                </Viewbox>
                            </Border>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>
