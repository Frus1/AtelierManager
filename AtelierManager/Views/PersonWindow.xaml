<Window x:Class="AtelierManager.Views.PersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Персона"
        Height="220"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/ateliersubicon.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Имя / обозначение" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding DisplayName}" Margin="0,0,0,12"/>

            <TextBlock Text="Пол" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox SelectedValue="{Binding Gender}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Мужской" Tag="M"/>
                <ComboBoxItem Content="Женский" Tag="F"/>
                <ComboBoxItem Content="Не указан" Tag="U"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="ОК" Width="100" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>