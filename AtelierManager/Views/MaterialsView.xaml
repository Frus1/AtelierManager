<UserControl x:Class="AtelierManager.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Список -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Материалы"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,12,8"/>

            <StackPanel Grid.Row="1" Margin="0,0,12,8">
                <TextBox md:HintAssist.Hint="Поиск по названию или единице"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Width="190"
                          HorizontalAlignment="Left"
                          Margin="0,6,0,0"
                          md:HintAssist.Hint="Фильтр"
                          ItemsSource="{Binding MaterialFilters}"
                          SelectedItem="{Binding SelectedFilter}"/>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding MaterialsView}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      GridLinesVisibility="None"
                      Margin="0,0,12,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.##}}" Width="80"/>
                    <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:0.##}}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,0,12,0">
                <Button x:Name="AddMaterialButton" Style="{StaticResource ActionButton}" Click="AddMaterial_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Добавить"/>
                    </StackPanel>
                </Button>

                <Button x:Name="EditMaterialButton" Style="{StaticResource ActionButton}" Click="EditMaterial_Click" IsEnabled="{Binding HasSelectedMaterial}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Изменить"/>
                    </StackPanel>
                </Button>

                <Button x:Name="DeleteMaterialButton" Style="{StaticResource ActionButton}" Click="DeleteMaterial_Click" IsEnabled="{Binding HasSelectedMaterial}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Click="RefreshMaterial_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Карточка -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">

            <Grid>
                <!-- Заглушка -->
                <TextBlock Text="Выберите материал слева, чтобы увидеть его карточку."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Opacity="0.6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Карточка -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Карточка материала" Style="{StaticResource CardTitleText}"/>

                    <TextBlock Text="Название" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Selected.Name}" Margin="0,0,0,12"/>

                    <TextBlock Text="Количество" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Selected.Quantity, StringFormat={}{0:0.##}}" Margin="0,0,0,12"/>

                    <TextBlock Text="Единица измерения" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Selected.Unit}" Margin="0,0,0,12"/>

                    <TextBlock Text="Цена" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Selected.Price, StringFormat={}{0:0.##}}" Margin="0,0,0,12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>