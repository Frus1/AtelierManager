<UserControl x:Class="AtelierManager.Views.OrdersView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== ЛЕВО: список заказов ================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Заказы"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,12,8"/>

            <StackPanel Grid.Row="1" Margin="0,0,12,8">
                <TextBox md:HintAssist.Hint="Поиск по заказу, клиенту, статусу, работнику"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <WrapPanel Margin="0,6,0,0">
                    <ComboBox Width="155"
                              Margin="0,0,6,0"
                              md:HintAssist.Hint="Статус"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"/>
                    <ComboBox Width="145"
                              Margin="0,0,6,0"
                              md:HintAssist.Hint="Источник"
                              ItemsSource="{Binding MaterialSourceFilters}"
                              SelectedItem="{Binding SelectedMaterialSourceFilter}"/>
                    <ComboBox Width="145"
                              Margin="0,0,6,0"
                              md:HintAssist.Hint="Состояние"
                              ItemsSource="{Binding OrderStateFilters}"
                              SelectedItem="{Binding SelectedOrderStateFilter}"/>
                    <ComboBox Width="165"
                              md:HintAssist.Hint="Работник"
                              ItemsSource="{Binding EmployeeFilters}"
                              SelectedItem="{Binding SelectedEmployeeFilter}"
                              DisplayMemberPath="FullName"/>
                </WrapPanel>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding OrdersView}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      GridLinesVisibility="None"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      Margin="0,0,12,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Client.FullName}" Width="170"/>
                    <DataGridTextColumn Header="Заказ" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTextColumn Header="Принят" Binding="{Binding IntakeDate, StringFormat=dd.MM.yyyy}" Width="95"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status.Name}" Width="95"/>
                    <DataGridTextColumn Header="Работник" Binding="{Binding Employee.FullName}" Width="120"/>
                    <DataGridTextColumn Header="Итого" Binding="{Binding TotalCost, StringFormat={}{0:0.##}}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,12,0">
                <Button Style="{StaticResource ActionButton}" Click="AddOrder_Click" Visibility="{Binding OrderManagementVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Добавить"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Click="EditOrder_Click" IsEnabled="{Binding HasSelectedOrder}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Изменить"/>
                    </StackPanel>
                </Button>
                <Button Click="DeleteOrder_Click" IsEnabled="{Binding HasSelectedOrder}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanDeleteOrders}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Click="RefreshOrder_Click">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================== ПРАВО: карточка заказа ================== -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <Grid>
            <TextBlock Text="Выберите заказ слева, чтобы увидеть подробности."
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               TextAlignment="Center"
               Opacity="0.6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- ВАЖНО: StackPanel в ScrollViewer => Collapsed блоки не занимают места,
                 всё нижнее поднимается вверх автоматически -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>

                    <TextBlock Text="Детали заказа" Style="{StaticResource CardTitleText}"/>

                    <!-- Шапка -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <md:PackIcon Kind="Account" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Selected.Client.FullName}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <md:PackIcon Kind="Flag" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Selected.Status.Name}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <md:PackIcon Kind="AccountTie" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Selected.Employee.FullName, TargetNullValue=Не указан, StringFormat=Работник: {0}}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <md:PackIcon Kind="Calendar" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Selected.IntakeDate, StringFormat=Принят: {0:dd.MM.yyyy}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <md:PackIcon Kind="CalendarClock" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Selected.DueDate, StringFormat=Срок: {0:dd.MM.yyyy}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <md:PackIcon Kind="Cash" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Selected.TotalCost, StringFormat=Итого: {0:0.##}}"
                                    FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Мерки ===== -->
                    <GroupBox Header="Мерки (для выбранной позиции)" Margin="0,0,0,12">
                        <GroupBox.Style>
                            <Style TargetType="GroupBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeasurementsNeededForSelectedLine}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GroupBox.Style>

                        <TextBlock Text="{Binding SelectedLineMeasurementSummary}" TextWrapping="Wrap"/>
                    </GroupBox>



                    <!-- ===== Материалы ===== -->
                    <GroupBox Header="Материалы" Margin="0,0,0,12">
                        <StackPanel>

                            <TextBlock Text="{Binding Selected.MaterialSource, StringFormat=Источник материала: {0}}"
                                       Margin="0,0,0,6"/>

                            <!-- Материал клиента: показываем как свободный текст -->
                            <TextBlock Text="Материал клиента / комментарий:"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding Selected.MaterialComment}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <!-- Материалы ателье: показывать ТОЛЬКО если Atelier или Mixed -->
                            <GroupBox Header="Материалы ателье (список)" Margin="0,4,0,0">
                                <GroupBox.Style>
                                    <Style TargetType="GroupBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.MaterialSource}" Value="Ателье">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Selected.MaterialSource}" Value="Смешанное">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupBox.Style>

                                <DataGrid ItemsSource="{Binding SelectedOrderMaterials}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="None"
                                          CanUserResizeColumns="False"
                                          CanUserReorderColumns="False"
                                          Height="150">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Материал" Binding="{Binding Material.Name}" Width="*"/>
                                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QtyUsed}" Width="80"/>
                                        <DataGridTextColumn Header="Ед." Binding="{Binding Material.Unit}" Width="60"/>
                                        <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:0.##}, TargetNullValue=0, FallbackValue=0}" Width="80"/>
                                        <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:0.##}, TargetNullValue=0, FallbackValue=0}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                        </StackPanel>
                    </GroupBox>

                    <!-- ===== Услуги + допы (всегда идут выше, если материалы/мерки скрыты) ===== -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="Услуги в заказе" Margin="0,0,0,8">
                            <DataGrid ItemsSource="{Binding SelectedOrderServices}"
                                SelectedItem="{Binding SelectedOrderService}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                RowHeaderWidth="0"
                                GridLinesVisibility="None"
                                CanUserResizeColumns="False"
                                CanUserReorderColumns="False"
                                Height="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}" Width="*"/>
                                    <DataGridTextColumn Header="Для кого" Binding="{Binding Person.DisplayName}" Width="140"/>
                                    <DataGridTextColumn Header="Цена" Binding="{Binding BasePrice, StringFormat={}{0:0.##}}" Width="80"/>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:0.##}}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                            <GroupBox Grid.Row="1" Header="Доп. элементы (для выбранной услуги)">
                                <Grid>
                                    <TextBlock Text="Выберите позицию заказа, чтобы увидеть доп. элементы."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Opacity="0.6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedOrderService}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <DataGrid ItemsSource="{Binding SelectedOrderServiceExtras}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  GridLinesVisibility="None"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  Height="160">
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedOrderService}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Элемент" Binding="{Binding ExtraElement.Name}" Width="*"/>
                                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Qty}" Width="70"/>
                                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:0.##}}" Width="80"/>
                                            <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:0.##}}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>
                        </Grid>

                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
