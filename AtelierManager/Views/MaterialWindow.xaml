<Window x:Class="AtelierManager.Views.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Материал"
        Height="350"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/ateliersubicon.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Название" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Name}" Margin="0,0,0,12"/>

            <TextBlock Text="Количество" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Quantity}" Margin="0,0,0,12"/>

            <TextBlock Text="Единица измерения" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Unit}" Margin="0,0,0,12"/>

            <TextBlock Text="Цена" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Price}" Margin="0,0,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="ОК" Width="100" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>