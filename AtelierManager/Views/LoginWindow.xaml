<Window x:Class="AtelierManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Вход в приложение"
        Height="330"
        Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/ateliericon.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Авторизация" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Введите логин и пароль работника" Opacity="0.7" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="LoginTextBox"
                     md:HintAssist.Hint="Логин"
                     Margin="0,0,0,14"
                     KeyDown="Input_KeyDown"/>

            <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox"
                         md:HintAssist.Hint="Пароль"
                         Margin="0,0,0,8"
                         KeyDown="Input_KeyDown"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Войти" Width="110" Margin="0,0,8,0" Click="Login_Click"/>
            <Button Content="Отмена" Width="110" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
