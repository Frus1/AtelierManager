<Window x:Class="AtelierManager.Views.ServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга"
        Height="320"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/ateliersubicon.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Название" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Name}" Margin="0,0,0,12"/>

            <TextBlock Text="Тип услуги" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding ServiceTypes}"
                      SelectedItem="{Binding ServiceType}"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Базовая цена" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding BasePrice}" Margin="0,0,0,12"/>

            <CheckBox Content="Активна"
                      IsChecked="{Binding IsActive}"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="ОК" Width="100" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>