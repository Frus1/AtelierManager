<UserControl x:Class="AtelierManager.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Работники" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Управление учётными записями и ролями пользователей приложения" Opacity="0.7"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="180"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="160"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.DisplayName}" Width="170"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource ActionButton}" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Добавить"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButton}" Click="Edit_Click" IsEnabled="{Binding HasSelectedEmployee}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Изменить"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButton}" Click="ToggleActive_Click" IsEnabled="{Binding HasSelectedEmployee}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AccountCancel" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Вкл/выкл"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButton}" Click="Delete_Click" IsEnabled="{Binding HasSelectedEmployee}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Удалить"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButton}" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Обновить"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
