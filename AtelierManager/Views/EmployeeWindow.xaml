<Window x:Class="AtelierManager.Views.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Работник"
        Height="440"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/ateliersubicon.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ФИО" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding FullName}" Margin="0,0,0,12"/>

            <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Login}" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Password}" Margin="0,0,0,12"/>

            <TextBlock Text="Роль" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      DisplayMemberPath="DisplayName"
                      Margin="0,0,0,12"/>

            <CheckBox Content="Работник активен"
                      IsChecked="{Binding IsActive}"
                      Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="ОК" Width="100" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
