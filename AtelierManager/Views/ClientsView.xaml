<UserControl x:Class="AtelierManager.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Список -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Клиенты"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,12,8"/>

            <StackPanel Grid.Row="1" Margin="0,0,12,8">
                <TextBox md:HintAssist.Hint="Поиск по клиентам и персонам"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Width="220"
                          HorizontalAlignment="Left"
                          Margin="0,6,0,0"
                          md:HintAssist.Hint="Фильтр"
                          ItemsSource="{Binding ClientFilters}"
                          SelectedItem="{Binding SelectedFilter}"/>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      CanUserAddRows="False"
                      VerticalContentAlignment="Top"
                      ItemsSource="{Binding Clients}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      GridLinesVisibility="None"
                      Margin="0,0,12,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Клиенты" Binding="{Binding FullName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,0">
                <Button Style="{StaticResource ActionButton}" Click="AddClient_Click" Visibility="{Binding ClientManagementVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Добавить"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Click="EditClient_Click" IsEnabled="{Binding HasSelectedClient}" Visibility="{Binding ClientManagementVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Изменить"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Click="DeleteClient_Click" IsEnabled="{Binding HasSelectedClient}" Visibility="{Binding ClientManagementVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Click="RefreshClient_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Правая часть -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">

            <Grid>
                <!-- Заглушка -->
                <TextBlock Text="Выберите клиента слева, чтобы увидеть карточку, персон и мерки."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Opacity="0.6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Основное содержимое -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <TextBlock Text="Карточка клиента" Style="{StaticResource CardTitleText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <md:PackIcon Kind="Account" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="ФИО" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.FullName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <md:PackIcon Kind="Phone" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Телефон" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.Phone}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <md:PackIcon Kind="Email" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Email" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.Email}" Margin="0,0,0,12"/>

                        <!-- Персоны -->
                        <GroupBox Header="Персоны клиента" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="У выбранного клиента пока нет персон."
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           TextWrapping="Wrap"
           TextAlignment="Center"
           Opacity="0.6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasClientPersons}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DataGrid ItemsSource="{Binding ClientPersons}"
                                    SelectedItem="{Binding SelectedPerson}"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    RowHeaderWidth="0"
                                    GridLinesVisibility="None"
                                    Height="140">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasClientPersons}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имя / обозначение" Binding="{Binding DisplayName}" Width="*"/>
                                        <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1"
                                     Orientation="Horizontal"
                                     HorizontalAlignment="Right"
                                     Margin="0,12,0,0"
                                     Visibility="{Binding ClientManagementVisibility}">

                                    <Button Style="{StaticResource ActionButton}" Click="AddPerson_Click" IsEnabled="{Binding HasSelectedClient}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Добавить"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource ActionButton}" Click="EditPerson_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Изменить"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource ActionButton}" Click="DeletePerson_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Удалить"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Мерки -->
                        <GroupBox Header="Мерки выбранной персоны" Margin="0,0,0,12">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPerson}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="У выбранной персоны пока нет мерок."
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    Opacity="0.6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedPersonMeasurements}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DataGrid ItemsSource="{Binding SelectedPersonMeasurementSets}"
                                    SelectedItem="{Binding SelectedMeasurementSet}"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    RowHeaderWidth="0"
                                    GridLinesVisibility="None"
                                    Height="140">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedPersonMeasurements}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата" Binding="{Binding TakenAt, StringFormat=dd.MM.yyyy}" Width="110"/>
                                        <DataGridTextColumn Header="Основные мерки" Binding="{Binding Summary}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding ClientManagementVisibility}">
                                    <Button Style="{StaticResource ActionButton}" Click="AddMeasurement_Click" IsEnabled="{Binding HasSelectedClient}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Добавить"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource ActionButton}" Click="EditMeasurement_Click" IsEnabled="{Binding HasSelectedMeasurementSet}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Изменить"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource ActionButton}" Click="DeleteMeasurement_Click" IsEnabled="{Binding HasSelectedMeasurementSet}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Удалить"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Детали мерок -->
                        <GroupBox Header="Детали выбранных мерок">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMeasurementSet}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMeasurementSet.TakenAt, StringFormat=Сняты: {0:dd.MM.yyyy}}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding SelectedMeasurementSet.Summary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMeasurementSet.TopText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedMeasurementSet.TopText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Верх" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedMeasurementSet.TopText}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMeasurementSet.BottomText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedMeasurementSet.BottomText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Низ" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedMeasurementSet.BottomText}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMeasurementSet.ProductText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedMeasurementSet.ProductText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Изделие" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedMeasurementSet.ProductText}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedMeasurementSet.Comment}"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>